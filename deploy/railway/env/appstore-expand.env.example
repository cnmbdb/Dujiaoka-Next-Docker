# Paste only into the Railway appstore-expand service.
PORT=8080
APPSTORE_TITLE=Dujiao App Store
APPSTORE_BUTTON_TEXT=插件商店
APPSTORE_STATUS_TEXT=插件管理服务已启用
APPSTORE_FRONTEND_URL=https://ets.txsw.top
APPSTORE_FRONTEND_LOGIN_PATH=/login
APPSTORE_CATALOG_API_URL=https://ets.txsw.top/api/extensions
APPSTORE_CATALOG_TTL_MS=300000
APPSTORE_REQUEST_TIMEOUT_MS=120000

# Must be different from every API secret and kept private.
APPSTORE_API_TOKEN=CHANGE_ME
