# Paste only into the Railway api service.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release

DATABASE_DRIVER=postgres
DATABASE_DSN=${{Postgres.DATABASE_URL}}
DATABASE_POOL_MAX_OPEN_CONNS=10
DATABASE_POOL_MAX_IDLE_CONNS=5
DATABASE_POOL_CONN_MAX_LIFETIME_SECONDS=1800
DATABASE_POOL_CONN_MAX_IDLE_TIME_SECONDS=300

REDIS_ENABLED=true
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
REDIS_DB=0
REDIS_PREFIX=dj

QUEUE_ENABLED=true
QUEUE_HOST=${{Redis.REDISHOST}}
QUEUE_PORT=${{Redis.REDISPORT}}
QUEUE_PASSWORD=${{Redis.REDISPASSWORD}}
QUEUE_DB=1
QUEUE_CONCURRENCY=10
QUEUE_UPSTREAM_SYNC_INTERVAL=5m

# Replace all three values with different outputs of: openssl rand -hex 32
APP_SECRET_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
USER_JWT_SECRET=CHANGE_ME

DJ_DEFAULT_ADMIN_USERNAME=admin
DJ_DEFAULT_ADMIN_PASSWORD=CHANGE_ME
WEB_ADMIN_PATH=/admin
