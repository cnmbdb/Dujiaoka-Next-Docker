{
  "$schema": "../plugin.schema.json",
  "schemaVersion": 1,
  "id": "dujiao-bot",
  "name": "Dujiao Bot",
  "version": "1.0.0",
  "description": "Telegram 自动发货、客服、通知和订单查询插件。",
  "author": "D&J Studio",
  "license": "MIT",
  "icon": "public/images/icon.svg",
  "selfManaged": true,
  "compatibility": {
    "pluginApi": "^1.0.0",
    "dujiaoNext": ">=1.0.0"
  },
  "entrypoints": {
    "compose": "docker-compose.yml",
    "backend": {
      "service": "dujiao-bot",
      "port": 3020,
      "healthPath": "/health"
    },
    "admin": {
      "type": "iframe",
      "path": "/plugins/dujiao-bot/ui/",
      "title": "Dujiao Bot"
    },
    "public": {
      "scripts": ["public/inject.js"],
      "styles": []
    }
  },
  "dependencies": ["core:postgres", "core:redis", "core:api"],
  "permissions": [
    "database:read",
    "database:write",
    "redis:read",
    "redis:write",
    "network:outbound",
    "filesystem:plugin-data"
  ],
  "lifecycle": {
    "install": "hooks/install.sh",
    "enable": "hooks/enable.sh",
    "disable": "hooks/disable.sh",
    "uninstall": "hooks/uninstall.sh"
  },
  "data": {
    "paths": ["data", "logs"],
    "removeOnUninstall": false
  }
}
