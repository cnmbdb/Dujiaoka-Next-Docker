BOT_IMAGE=ghcr.io/cnmbdb/dujioka-next-tgbot/dujiao-bot
BOT_TAG=latest
NODE_ENV=production
PORT=3020
HOST=0.0.0.0

DB_HOST=dujiao-postgres
DB_PORT=5432
DB_NAME=dujiao_db
DB_USER=dujiao_user
DB_PASSWORD=dujiao_password

REDIS_HOST=dujiao-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

API_BASE_URL=http://dujiao-next-api:3000
API_INTERNAL_URL=http://dujiao-next-api:3000
DUJIAOKA_API_URL=http://dujiao-next-api:3000

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_HEADLINE=
TELEGRAM_BOT_SUBTITLE=Dujiao-Next 官方演示机器人
TELEGRAM_AUTH_DOC_URL=
TELEGRAM_PROMO_LINE=
TELEGRAM_SHOP_URL=
TELEGRAM_SHOP_PRODUCT_PATH=/products
TELEGRAM_REFERRAL_URL=
TELEGRAM_GIFT_URL=
TELEGRAM_MINI_APP_URL=
TELEGRAM_CUSTOMER_SERVICE_URL=

ENABLE_AUTO_DELIVERY=true
ENABLE_CUSTOMER_SERVICE=true
ENABLE_NOTIFICATION=true
ENABLE_ORDER_TRACKING=true
ENABLE_BROADCAST=true
AUTO_DELIVERY_ENABLED=true
CUSTOMER_SERVICE_ENABLED=true

JWT_SECRET=change-me
SESSION_SECRET=change-me
LOG_LEVEL=info
LOG_DIR=/plugin/logs
