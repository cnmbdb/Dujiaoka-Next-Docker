ALOUER_IMAGE=ghcr.io/cnmbdb/alouer-steal
ALOUER_TAG=latest
ALOUER_PULL_POLICY=always
ALOUER_PORT=3025
ALOUER_DB_HOST=dujiao-postgres
ALOUER_DB_PORT=5432
ALOUER_DB_NAME=${DB_NAME:-dujiao_db}
ALOUER_DB_USER=${DB_USER:-dujiao_user}
ALOUER_DB_PASSWORD=${DB_PASSWORD:-dujiao_password}
ALOUER_PUBLIC_PATH=/plugins/alouer-steal
